{
	"schemaVersion": 1,
	"id": "waterbucket",
	"version": "${version}",
	"name": "Water Bucket Extinguish",
	"description": "Client-side PvP utility: one key switches to your water bucket, places it, and picks it back up.",
	"authors": [
		"RpYT"
	],
	"contact": {
		"homepage": "https://github.com/RpYTMc/WaterBucketExtinguish",
		"issues": "https://github.com/RpYTMc/WaterBucketExtinguish/issues",
		"sources": "https://github.com/RpYTMc/WaterBucketExtinguish"
	},
	"license": "MIT",
	"icon": "assets/waterbucket/icon.png",
	"environment": "client",
	"entrypoints": {
		"main": [
			"water.bucket.WaterBucket"
		],
		"client": [
			"water.bucket.WaterBucketClient"
		],
		"modmenu": [
			"water.bucket.integration.ModMenuIntegration"
		]
	},
	"depends": {
		"fabricloader": ">=0.18.4",
		"minecraft": ">=26.3 <26.4",
		"java": ">=25",
		"fabric-api": "*",
		"cloth-config": "*"
	},
	"suggests": {
		"modmenu": "*"
	}
}
